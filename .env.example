# ============================================================
# CONCESIONARIA TOYOTA FORMOSA — Variables de entorno
# Copiá este archivo a .env y completá los valores reales.
# ============================================================

# ---- Base de datos ----
# Dev/Demo: SQLite local. Producción: cambiar a PostgreSQL (Supabase/Vercel).
# Ej. PostgreSQL: postgresql://user:pass@host:5432/db?schema=public
DATABASE_URL="file:./dev.db"

# ---- Autenticación (Auth.js / NextAuth v5) ----
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ---- Sitio ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Modo DEMO / Portfolio ----
# Cuando es true: insignia "DEMO" discreta, datos ilustrativos y
# NO se envían comunicaciones reales. Toda la lógica de producción queda lista.
NEXT_PUBLIC_DEMO_MODE=true

# ---- Contacto ----
# Placeholder de WhatsApp internacional (con código de país, sin +).
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# ---- Credenciales DEMO (SOLO desarrollo/demo; usadas por el seed) ----
# NO usar estas credenciales en producción.
DEMO_ADMIN_EMAIL="admin@demo.local"
DEMO_ADMIN_PASSWORD="admin123"
DEMO_SELLER_EMAIL="vendedor@demo.local"
DEMO_SELLER_PASSWORD="admin123"
DEMO_SERVICE_EMAIL="service@demo.local"
DEMO_SERVICE_PASSWORD="admin123"

# ------------------------------------------------------------
# Email — Resend (https://resend.com)
# ------------------------------------------------------------
# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=""
# Remitente verificado en Resend (dominio o onboarding@resend.dev para pruebas)
EMAIL_FROM="Toyota Formosa <onboarding@resend.dev>"
# Destinatario para notificaciones de leads (admin/comercial)
EMAIL_TO=""
# En DEMO_MODE=true no se envía real: solo se loguea en consola

# ------------------------------------------------------------
# Opcionales (se completan al integrar servicios reales)
# ------------------------------------------------------------
# STORAGE_URL=""
# STORAGE_KEY=""
